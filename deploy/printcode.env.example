# /etc/printcode.env — PrintCode 서버 설정. 값을 바꾸면: sudo systemctl restart printcode
# (setup.sh가 처음 한 번 이 파일을 복사한다. 이미 있으면 덮어쓰지 않는다)

# 암호문·DB 저장 폴더 (printcode.service의 StateDirectory와 같아야 함)
PRINTCODE_DATA_DIR=/var/lib/printcode

# 파일 하나의 최대 크기(MB). 0 = 제한 없음 (실제 한계는 업로드·출력 PC의 메모리)
PRINTCODE_MAX_PDF_MB=0

# 서버에 동시에 보관하는 암호문 전체 크기(MB). 디스크의 절반 정도 (50GB 디스크 → 20480)
PRINTCODE_MAX_TOTAL_MB=20480

# 업로드 후 유효 시간(초), 코드 예약 후 업로드까지 허용 시간(초)
PRINTCODE_FILE_TTL=1800
PRINTCODE_RESERVE_TTL=300
